<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="wundcheck_defs" targetNamespace="http://fhnw.ch/msc-mi/cdss/wundcheck">
  <bpmn:collaboration id="collab1">
    <bpmn:participant id="pool1" name="WundCheck — Daily wound check after surgery" processRef="proc1" />
  </bpmn:collaboration>
  <bpmn:process id="proc1" isExecutable="false">
    <bpmn:laneSet id="laneset1"><bpmn:lane id="lane_pat" name="Patient"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t_check</bpmn:flowNodeRef><bpmn:flowNodeRef>end_pat</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_app" name="WundCheck app (CDSS)"><bpmn:flowNodeRef>t_val</bpmn:flowNodeRef><bpmn:flowNodeRef>t_rules</bpmn:flowNodeRef><bpmn:flowNodeRef>gw</bpmn:flowNodeRef><bpmn:flowNodeRef>t_green</bpmn:flowNodeRef><bpmn:flowNodeRef>t_orange</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_prax" name="Practice / hospital"><bpmn:flowNodeRef>t_triage</bpmn:flowNodeRef><bpmn:flowNodeRef>t_contact</bpmn:flowNodeRef><bpmn:flowNodeRef>end_prax</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_ehr" name="HIS / patient record (EHR)"><bpmn:flowNodeRef>t_ehr</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="start" name="Daily reminder"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="t_check" name="Perform wound check (values + select wound image)"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="t_val" name="Validate inputs (constraints)"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask><bpmn:businessRuleTask id="t_rules" name="Evaluate rules, derive wound score (L3)"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:businessRuleTask><bpmn:exclusiveGateway id="gw" name="Classification?"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_green" name="GREEN/YELLOW: show recommendation"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing><bpmn:outgoing>f8</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="t_orange" name="ORANGE/RED: show instruction + send alert"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="t_ehr" name="Store result (FHIR QuestionnaireResponse + Observation wound score)"><bpmn:incoming>f8</bpmn:incoming><bpmn:incoming>f9</bpmn:incoming></bpmn:serviceTask><bpmn:userTask id="t_triage" name="Triage alert (practice assistant / nurse)"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="t_contact" name="Contact patient / arrange appointment"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="end_pat" name="Check completed"><bpmn:incoming>f7</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="end_prax" name="Follow-up initiated"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" name="" sourceRef="start" targetRef="t_check" /><bpmn:sequenceFlow id="f2" name="" sourceRef="t_check" targetRef="t_val" /><bpmn:sequenceFlow id="f3" name="" sourceRef="t_val" targetRef="t_rules" /><bpmn:sequenceFlow id="f4" name="" sourceRef="t_rules" targetRef="gw" /><bpmn:sequenceFlow id="f5" name="green / yellow" sourceRef="gw" targetRef="t_green" /><bpmn:sequenceFlow id="f6" name="orange / red" sourceRef="gw" targetRef="t_orange" /><bpmn:sequenceFlow id="f7" name="" sourceRef="t_green" targetRef="end_pat" /><bpmn:sequenceFlow id="f8" name="" sourceRef="t_green" targetRef="t_ehr" /><bpmn:sequenceFlow id="f9" name="" sourceRef="t_orange" targetRef="t_ehr" /><bpmn:sequenceFlow id="f10" name="Alert" sourceRef="t_orange" targetRef="t_triage" /><bpmn:sequenceFlow id="f11" name="" sourceRef="t_triage" targetRef="t_contact" /><bpmn:sequenceFlow id="f12" name="" sourceRef="t_contact" targetRef="end_prax" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="dia1">
    <bpmndi:BPMNPlane id="plane1" bpmnElement="collab1">
      <bpmndi:BPMNShape id="pool1_di" bpmnElement="pool1" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1380" height="660" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="90" y="105" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_check_di" bpmnElement="t_check"><dc:Bounds x="170" y="92" width="150" height="62" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_val_di" bpmnElement="t_val"><dc:Bounds x="200" y="280" width="150" height="62" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_rules_di" bpmnElement="t_rules"><dc:Bounds x="400" y="280" width="150" height="62" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw_di" bpmnElement="gw"><dc:Bounds x="610" y="286" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_green_di" bpmnElement="t_green"><dc:Bounds x="730" y="220" width="150" height="62" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_orange_di" bpmnElement="t_orange"><dc:Bounds x="730" y="330" width="150" height="62" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_ehr_di" bpmnElement="t_ehr"><dc:Bounds x="950" y="595" width="170" height="70" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_triage_di" bpmnElement="t_triage"><dc:Bounds x="950" y="460" width="150" height="62" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_contact_di" bpmnElement="t_contact"><dc:Bounds x="1160" y="460" width="150" height="62" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_pat_di" bpmnElement="end_pat"><dc:Bounds x="950" y="132" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_prax_di" bpmnElement="end_prax"><dc:Bounds x="1360" y="474" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="lane_pat_di" bpmnElement="lane_pat" isHorizontal="true"><dc:Bounds x="74" y="40" width="1346" height="170" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="lane_app_di" bpmnElement="lane_app" isHorizontal="true"><dc:Bounds x="74" y="210" width="1346" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="lane_prax_di" bpmnElement="lane_prax" isHorizontal="true"><dc:Bounds x="74" y="420" width="1346" height="150" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="lane_ehr_di" bpmnElement="lane_ehr" isHorizontal="true"><dc:Bounds x="74" y="570" width="1346" height="130" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="126" y="123" /><di:waypoint x="170" y="123" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="245" y="154" /><di:waypoint x="245" y="266" /><di:waypoint x="275" y="266" /><di:waypoint x="275" y="280" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="350" y="311" /><di:waypoint x="400" y="311" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="550" y="311" /><di:waypoint x="610" y="311" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="635" y="286" /><di:waypoint x="635" y="251" /><di:waypoint x="730" y="251" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="635" y="336" /><di:waypoint x="635" y="361" /><di:waypoint x="730" y="361" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="880" y="251" /><di:waypoint x="930" y="251" /><di:waypoint x="930" y="150" /><di:waypoint x="950" y="150" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="805" y="282" /><di:waypoint x="805" y="296" /><di:waypoint x="920" y="296" /><di:waypoint x="920" y="630" /><di:waypoint x="950" y="630" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="805" y="392" /><di:waypoint x="805" y="630" /><di:waypoint x="950" y="630" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="880" y="361" /><di:waypoint x="925" y="361" /><di:waypoint x="925" y="491" /><di:waypoint x="950" y="491" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="1100" y="491" /><di:waypoint x="1160" y="491" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="1310" y="491" /><di:waypoint x="1360" y="492" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>