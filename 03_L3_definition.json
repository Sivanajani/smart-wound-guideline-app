{
  "meta": {
    "title": "WundCheck — Tägliche Wundkontrolle nach OP (Nahtverschluss)",
    "version": "0.2.1",
    "l1_guideline": "SSI-Kriterien (CDC/NHSN) & NICE NG125 — vereinfachter Entwurf, von der Gruppe zu validieren",
    "disclaimer": "Studienprototyp FHNW MSc MI – nicht für die klinische Anwendung. Im Zweifel immer die Praxis / den Notfall kontaktieren.",
    "language": "de",
    "changelog": [
      { "version": "0.1.0", "date": "2026-07-28", "changes": "Erstes L3: Platzhalter Hypertonie-Screening (14 Elemente)" },
      { "version": "0.2.0", "date": "2026-07-28", "changes": "Use Case WundCheck: 28 Elemente, Ampel-Regeln R1-R8 + I1-I3, Bild-Antwortoptionen" },
      { "version": "0.2.1", "date": "2026-07-28", "changes": "Element 'crust' (Wundschorf) + Info-Regel I4; Regressionstests T1-T10 bestanden" }
    ]
  },
  "sections": [
    { "id": "stamm", "title": "1 · Angaben zur Operation (einmalig)" },
    { "id": "risiko", "title": "2 · Risikofaktoren (einmalig)" },
    { "id": "allgemein", "title": "3 · Tägliche Kontrolle — Allgemeinzustand" },
    { "id": "wunde", "title": "4 · Tägliche Kontrolle — Wunde" }
  ],
  "elements": [
    { "id": "pat_name", "label": "Name", "section": "stamm", "type": "text", "required": true },
    { "id": "pat_dob", "label": "Geburtsdatum", "section": "stamm", "type": "date", "required": true,
      "constraint": { "expr": "pat_dob <= today()", "message": "Geburtsdatum darf nicht in der Zukunft liegen." },
      "mapping": "LOINC 21112-8" },
    { "id": "pat_age", "label": "Alter", "section": "stamm", "type": "calculated", "unit": "Jahre",
      "calculation": "ageYears(pat_dob)", "mapping": "LOINC 30525-0" },
    { "id": "op_date", "label": "Datum der Operation", "section": "stamm", "type": "date", "required": true,
      "constraint": { "expr": "op_date <= today()", "message": "OP-Datum darf nicht in der Zukunft liegen." },
      "mapping": "SNOMED CT 387713003 (chirurgischer Eingriff)" },
    { "id": "days_post_op", "label": "Tage seit der Operation", "section": "stamm", "type": "calculated", "unit": "Tage",
      "calculation": "daysSince(op_date)" },
    { "id": "op_site", "label": "Körperstelle der Wunde", "section": "stamm", "type": "select_one", "required": true,
      "options": [
        { "value": "kiefer", "label": "Kiefer / Mund" }, { "value": "bauch", "label": "Bauch" },
        { "value": "bein", "label": "Bein / Hüfte" }, { "value": "arm", "label": "Arm / Schulter" },
        { "value": "andere", "label": "Andere" } ] },
    { "id": "closure", "label": "Wundverschluss", "section": "stamm", "type": "select_one", "required": true,
      "options": [
        { "value": 1, "label": "Naht (Fäden)" }, { "value": 2, "label": "Klammern" }, { "value": 3, "label": "Kleber / Steristrips" } ] },

    { "id": "diabetes", "label": "Haben Sie Diabetes?", "section": "risiko", "type": "select_one", "required": true,
      "options": [ { "value": 1, "label": "Ja" }, { "value": 0, "label": "Nein" }, { "value": 9, "label": "Weiss nicht" } ],
      "mapping": "ICD-10 E10–E14" },
    { "id": "smoker", "label": "Rauchen Sie?", "section": "risiko", "type": "select_one", "required": true,
      "options": [ { "value": 1, "label": "Ja" }, { "value": 0, "label": "Nein" } ],
      "mapping": "SNOMED CT 77176002" },
    { "id": "immunosuppr", "label": "Nehmen Sie Medikamente, die das Immunsystem schwächen (z.B. Kortison, Chemotherapie)?", "section": "risiko", "type": "select_one", "required": true,
      "options": [ { "value": 1, "label": "Ja" }, { "value": 0, "label": "Nein" }, { "value": 9, "label": "Weiss nicht" } ] },
    { "id": "anticoag", "label": "Nehmen Sie Blutverdünner?", "section": "risiko", "type": "select_one", "required": true,
      "options": [ { "value": 1, "label": "Ja" }, { "value": 0, "label": "Nein" }, { "value": 9, "label": "Weiss nicht" } ] },
    { "id": "risk_count", "label": "Anzahl Risikofaktoren (berechnet)", "section": "risiko", "type": "calculated",
      "calculation": "(diabetes = 1 ? 1 : 0) + (smoker = 1 ? 1 : 0) + (immunosuppr = 1 ? 1 : 0)" },

    { "id": "temp", "label": "Körpertemperatur heute", "section": "allgemein", "type": "decimal", "required": true, "unit": "°C",
      "constraint": { "expr": "temp >= 34 and temp <= 43", "message": "Plausible Temperatur: 34–43 °C." },
      "mapping": "LOINC 8310-5" },
    { "id": "fever", "label": "Fieber (ab 38.0 °C)", "section": "allgemein", "type": "calculated",
      "calculation": "temp >= 38 ? 'Ja' : 'Nein'" },
    { "id": "chills", "label": "Hatten Sie Schüttelfrost?", "section": "allgemein", "type": "select_one", "required": true,
      "options": [ { "value": 1, "label": "Ja" }, { "value": 0, "label": "Nein" } ],
      "mapping": "SNOMED CT 43724002" },
    { "id": "pain", "label": "Wie stark sind Ihre Schmerzen? (0 = keine, 10 = unerträglich)", "section": "allgemein", "type": "integer", "required": true,
      "constraint": { "expr": "pain >= 0 and pain <= 10", "message": "Bitte Wert zwischen 0 und 10." },
      "mapping": "LOINC 72514-3 (NRS)" },
    { "id": "pain_trend", "label": "Schmerzen im Vergleich zu gestern", "section": "allgemein", "type": "select_one", "required": true,
      "options": [ { "value": 0, "label": "Besser" }, { "value": 1, "label": "Gleich" }, { "value": 2, "label": "Schlechter" } ] },
    { "id": "wellbeing", "label": "Wie fühlen Sie sich insgesamt?", "section": "allgemein", "type": "select_one", "required": true,
      "options": [ { "value": 0, "label": "Gut" }, { "value": 1, "label": "Etwas müde / schlapp" }, { "value": 2, "label": "Richtig krank" } ] },
    { "id": "meds_taken", "label": "Haben Sie Ihre verordneten Medikamente heute eingenommen?", "section": "allgemein", "type": "select_one", "required": true,
      "options": [ { "value": 1, "label": "Ja" }, { "value": 0, "label": "Nein" }, { "value": 2, "label": "Keine verordnet" } ] },

    { "id": "wound_state", "label": "Welches Bild passt am besten zu Ihrer Wunde heute?", "section": "wunde", "type": "select_one", "required": true,
      "options": [
        { "value": 1, "label": "Ruhig & trocken", "image": "data:image/svg+xml;base64," },
        { "value": 2, "label": "Leicht gerötet am Rand", "image": "data:image/svg+xml;base64," },
        { "value": 3, "label": "Deutlich gerötet & geschwollen", "image": "data:image/svg+xml;base64," },
        { "value": 4, "label": "Offen / Eiter sichtbar", "image": "data:image/svg+xml;base64," } ] },
    { "id": "redness", "label": "Wie weit geht die Rötung?", "section": "wunde", "type": "select_one", "required": true,
      "relevant": "wound_state >= 2",
      "options": [
        { "value": 1, "label": "Nur direkt am Wundrand" },
        { "value": 2, "label": "Über den Wundrand hinaus" },
        { "value": 3, "label": "Breitet sich aus / roter Streifen Richtung Körper" } ],
      "mapping": "SNOMED CT 247441003 (Erythem)" },
    { "id": "swelling", "label": "Ist die Umgebung der Wunde geschwollen?", "section": "wunde", "type": "select_one", "required": true,
      "options": [
        { "value": 0, "label": "Nein" }, { "value": 1, "label": "Leicht" },
        { "value": 2, "label": "Deutlich" }, { "value": 3, "label": "Stark & zunehmend" } ],
      "mapping": "SNOMED CT 65124004 (Schwellung)" },
    { "id": "secretion", "label": "Kommt Flüssigkeit aus der Wunde? Welches Bild passt?", "section": "wunde", "type": "select_one", "required": true,
      "options": [
        { "value": 0, "label": "Keine", "image": "data:image/svg+xml;base64," },
        { "value": 1, "label": "Klar / wässrig", "image": "data:image/svg+xml;base64," },
        { "value": 2, "label": "Blutig", "image": "data:image/svg+xml;base64," },
        { "value": 3, "label": "Trüb / gelblich (Eiter)", "image": "data:image/svg+xml;base64," } ],
      "mapping": "SNOMED CT 449736006 (Wundsekret)" },
    { "id": "secretion_smell", "label": "Riecht das Wundsekret unangenehm?", "section": "wunde", "type": "select_one", "required": true,
      "relevant": "secretion >= 1",
      "options": [ { "value": 1, "label": "Ja" }, { "value": 0, "label": "Nein" } ] },
    { "id": "bleeding", "label": "Blutet die Wunde?", "section": "wunde", "type": "select_one", "required": true,
      "options": [
        { "value": 0, "label": "Nein" },
        { "value": 1, "label": "Leicht (wenige Tropfen)" },
        { "value": 2, "label": "Stark (Verband durchnässt)" } ] },
    { "id": "wound_open", "label": "Sind die Wundränder geschlossen?", "section": "wunde", "type": "select_one", "required": true,
      "options": [
        { "value": 0, "label": "Ja, geschlossen" },
        { "value": 1, "label": "Kleine Lücke sichtbar" },
        { "value": 2, "label": "Wunde klafft auseinander" } ] },
    { "id": "warmth", "label": "Fühlt sich die Haut um die Wunde heiss an?", "section": "wunde", "type": "select_one", "required": true,
      "options": [ { "value": 1, "label": "Ja" }, { "value": 0, "label": "Nein" } ] },
    { "id": "crust", "label": "Hat sich Wundschorf / eine Kruste gebildet?", "section": "wunde", "type": "select_one", "required": true,
      "options": [ { "value": 1, "label": "Ja" }, { "value": 0, "label": "Nein" } ],
      "mapping": "SNOMED CT (Code von der Gruppe zu ergänzen)" },
    { "id": "numbness", "label": "Haben Sie neues Taubheitsgefühl oder Kribbeln an der Wunde?", "section": "wunde", "type": "select_one", "required": true,
      "options": [ { "value": 1, "label": "Ja" }, { "value": 0, "label": "Nein" } ] }
  ],
  "decision_rules": [
    { "id": "R1", "decision": "Wundstatus", "when": "temp >= 39 or chills = 1",
      "output": "NOTFALL — Hohes Fieber oder Schüttelfrost: Kontaktieren Sie SOFORT Ihre Praxis oder den Notfalldienst (Verdacht auf sich ausbreitende Infektion).",
      "priority": "red", "annotation": "Systemische Infektionszeichen haben höchste Priorität (worst-first).", "reference": "CDC/NHSN SSI; Sepsis-Red-Flags" },
    { "id": "R2", "decision": "Wundstatus", "when": "redness = 3",
      "output": "NOTFALL — Rötung breitet sich aus / roter Streifen: Noch heute ärztliche Beurteilung (Verdacht auf Lymphangitis).",
      "priority": "red", "reference": "NICE NG125" },
    { "id": "R3", "decision": "Wundstatus", "when": "wound_open = 2 or bleeding = 2 or wound_state = 4",
      "output": "NOTFALL — Offene Wunde, Eiter oder starke Blutung: Sofort Praxis / Notfall kontaktieren. Wunde mit sauberer Kompresse abdecken.",
      "priority": "red", "annotation": "Worst-first: Das Wundbild 'offen/Eiter' eskaliert immer, auch wenn andere Angaben unauffällig sind.", "reference": "Postop. Nachsorge-Standards" },
    { "id": "R4", "decision": "Wundstatus", "when": "secretion = 3 or secretion_smell = 1",
      "output": "INFEKTIONSVERDACHT — Eitriges oder übelriechendes Sekret: Kontaktieren Sie heute Ihre Praxis für einen Termin.",
      "priority": "orange", "annotation": "Eitriges Sekret ist ein Hauptkriterium der oberflächlichen SSI.", "reference": "CDC/NHSN SSI-Kriterium" },
    { "id": "R5", "decision": "Wundstatus", "when": "temp >= 38 or (pain >= 7 and pain_trend = 2 and days_post_op >= 3)",
      "output": "INFEKTIONSVERDACHT — Fieber oder zunehmende starke Schmerzen: Kontaktieren Sie heute Ihre Praxis.",
      "priority": "orange", "annotation": "Schmerz sollte ab Tag 3 rückläufig sein; Zunahme ist ein Warnzeichen.", "reference": "NICE NG125" },
    { "id": "R6", "decision": "Wundstatus", "when": "(wound_state = 3 or redness = 2 or swelling >= 2 or warmth = 1) and days_post_op >= 3",
      "output": "AUFFÄLLIG — Zunehmende Entzündungszeichen: Beobachten Sie die Wunde genau und melden Sie sich bei Ihrer Praxis, wenn es bis morgen nicht besser wird.",
      "priority": "yellow", "annotation": "Leichte Rötung/Schwellung ist in den ersten 2–3 Tagen normal (Wundheilungsphase).", "reference": "Wundheilungsphasen" },
    { "id": "R7", "decision": "Wundstatus", "when": "wound_open = 1 or numbness = 1",
      "output": "AUFFÄLLIG — Kleine Wundlücke oder neues Taubheitsgefühl: Beim nächsten Kontrolltermin ansprechen; bei Verschlechterung Praxis kontaktieren.",
      "priority": "yellow", "reference": "Postop. Nachsorge-Standards" },
    { "id": "R8", "decision": "Wundstatus", "when": "true",
      "output": "ALLES IM GRÜNEN BEREICH — Die Wundheilung verläuft normal. Machen Sie morgen die nächste Kontrolle.",
      "priority": "green", "annotation": "Catch-all-Regel: greift nur, wenn keine der obigen Regeln zutrifft.", "reference": "—" },
    { "id": "I1", "decision": "Hinweis", "exclusive": false, "when": "risk_count >= 2",
      "output": "Sie haben mehrere Risikofaktoren für Wundheilungsstörungen — nehmen Sie alle Kontrolltermine wahr.",
      "priority": "info", "reference": "SSI-Risikofaktoren" },
    { "id": "I2", "decision": "Hinweis", "exclusive": false, "when": "meds_taken = 0",
      "output": "Bitte nehmen Sie Ihre verordneten Medikamente ein — sie schützen die Wundheilung.",
      "priority": "info", "reference": "—" },
    { "id": "I3", "decision": "Hinweis", "exclusive": false, "when": "smoker = 1",
      "output": "Rauchen verlangsamt die Wundheilung — jetzt wäre ein guter Moment für eine Pause.",
      "priority": "info", "reference": "SSI-Risikofaktoren" },
    { "id": "I4", "decision": "Hinweis", "exclusive": false, "when": "crust = 1",
      "output": "Wundschorf (Kruste) ist ein normales Zeichen der Heilung — nicht abkratzen, Wunde trocken halten.",
      "priority": "info", "annotation": "Designentscheid: Kruste ist KEIN Warnzeichen; Warn-Regeln haben Vorrang (worst-first).", "reference": "Wundheilungsphasen" }
  ]
}
